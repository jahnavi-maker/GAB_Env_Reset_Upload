# GAB Environment Platform — config template.
# Copy to .env and fill in.  NEVER commit the real .env (it holds secrets).

# --- Supabase (shared DB: gab_accounts + reset_sessions) ---
SUPABASE_URL=https://tamrkayujdgnrbrhbsxz.supabase.co
SUPABASE_KEY=sb_publishable_qLIM4XIzaCt6uvU7Ql-u5w_tJ9TeUWL       # server-side only
SUPABASE_TABLE=reset_sessions
SUPABASE_ACCOUNTS_TABLE=gab_accounts
SUPABASE_LOGINS_TABLE=freelancers
LOGINS_USE_SUPABASE=1                            # 1 = gab_logins on this Supabase; 0 = local JSON

# --- API auth (Bearer for /api/*) ---
RESET_API_KEY=<random-secret>

# --- Public origin (OAuth redirect URI derives from this) ---
PUBLIC_BASE_URL=http://127.0.0.1:8791            # prod: https://<your-host>

# --- Freelancer reset links (signed, tamper-proof) ---
RESET_LINK_SECRET=<random-secret>                # leave empty for the dev raw-id fallback

# --- Reset engine (gab-seed) ---
GAB_SEED_BIN=/absolute/path/to/gab-env-platform/engine/.venv/bin/gab-seed
GAB_CONFIG=/absolute/path/to/config.json         # engine config: archive, token_dir, state_dir, accounts
GAB_RESET_MODE=delta                             # default op; auto-routes delta <-> reseed
GAB_RESET_TIMEOUT_S=5400
GAB_DRIVE_CACHE=1                                 # per-persona Drive cache (bulk speedup)

# --- Testing without real Google ---
GAB_RESET_SIMULATE=0                             # 1 = simulate resets/uploads (no Google calls)

# --- Persona archive tree (seeder) ---
GAB_PERSONA_ROOT=/absolute/path/to/personas

# --- Local fallback (used only when Supabase is unset; dev) ---
LOCAL_STORE_PATH=.reset_sessions.json

# --- Freelancer Google Sign-In (reset page login gate) ---
# Reset/status pages send the user to Google's email+password page (prompt=login).
# Register these on the Web client: JS origin http://127.0.0.1:8791
# and redirect URI http://127.0.0.1:8791/ui/google/callback
# Empty = tests use the email fallback. If unset (key missing), seeder/credentials.json is used.
GOOGLE_CLIENT_ID=<oauth-web-client-id>
