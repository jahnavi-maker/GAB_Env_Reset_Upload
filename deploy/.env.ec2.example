# EC2 .env for the GAB platform. Copy to /home/ubuntu/gab-env-platform/.env and
# fill the <...> values (copy secrets from your local .env). Do NOT commit real secrets.

# --- Host mode (local | ec2). This file is the EC2 profile. ---
GAB_DEPLOY_MODE=ec2

# --- Public origin (drives the OAuth redirect) ---
# Set to your real https host. Everything else follows automatically.
PUBLIC_BASE_URL=https://YOUR_DOMAIN

# --- API auth (platform sends Authorization: Bearer <key>) ---
RESET_API_KEY=<copy from local .env>

# --- Freelancer reset links (required in EC2 mode) ---
RESET_LINK_SECRET=<long-random-string>

# --- Freelancer Google sign-in (required in EC2 mode) ---
GOOGLE_CLIENT_ID=<oauth-web-client-id>
# Register JS origin https://YOUR_DOMAIN and redirect
# https://YOUR_DOMAIN/ui/google/callback + https://YOUR_DOMAIN/oauth/callback

# --- Supabase (SAME project/keys as local; it's cloud, unchanged) ---
SUPABASE_URL=<copy from local .env>
SUPABASE_KEY=<copy from local .env>
SUPABASE_TABLE=reset_sessions
SUPABASE_ACCOUNTS_TABLE=gab_accounts
SUPABASE_LOGINS_TABLE=freelancers
SUPABASE_FREELANCERS_TABLE=freelancers

# --- Engine (Vishal's gab_seeder) ---
GAB_CONFIG=/home/ubuntu/.config/gab-seeder/config.json
GAB_SEED_BIN=/home/ubuntu/gab-env-platform/engine/.venv/bin/gab-seed
GAB_RESET_SIMULATE=0
GAB_RESET_MODE=delta
GAB_RESET_TIMEOUT_S=5400
GAB_HTTP_TIMEOUT=120

# --- Concurrency (op-aware pools) ---
RESET_CONCURRENCY=10
SEED_CONCURRENCY=6
GAB_SKIP_VERIFY=1

# --- Paths (persistent; setup-ec2.sh creates these) ---
GAB_STATE_DIR=/home/ubuntu/gab-state
GAB_TOKEN_DIR=/home/ubuntu/gab-state/tokens
GAB_RUNS_DIR=/home/ubuntu/gab-state/state
RESET_LOG_DIR=/home/ubuntu/gab-state/qc_logs
GAB_LOGS_DIR=/home/ubuntu/gab-state/logs
LOG_RETENTION_DAYS=5
GAB_PERSONA_ROOT=/home/ubuntu/gab-data/PKJA_UltraEvals_Environments_
SEEDER_DIR=/home/ubuntu/gab-env-platform/seeder

# --- IMPORTANT: leave GAB_RESET_SERVICES_FORCE UNSET in production ---
# (It was a test-only override to skip Calendar while quota recovered.
#  Unset = all three services, Calendar included.)
