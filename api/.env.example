# Copy to .env and fill in. Never commit the real .env.

# --- API auth (platform -> this service) ---
# Shared secret the platform sends as: Authorization: Bearer <key>
RESET_API_KEY=change-me

# --- Supabase (session store + audit) ---
# Leave both blank to fall back to a local JSON file (dev only).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=YOUR-SERVICE-ROLE-OR-SCOPED-KEY
SUPABASE_TABLE=reset_sessions

# --- Reset engine (Vishal's gab_seeder) ---
GAB_SEED_BIN=gab-seed
GAB_CONFIG=/secure/path/gab-seeder/config.json
GAB_RESET_MODE=delta            # delta | reseed | reset
GAB_RESET_TIMEOUT_S=5400

# Set to 1 to test the full API + Supabase path WITHOUT calling Google.
GAB_RESET_SIMULATE=0

# Local fallback store path (used only when Supabase vars are empty).
LOCAL_STORE_PATH=.reset_sessions.json
